# Copia este archivo como ".env" (que NO se sube a git) y ajusta los valores.
# Para desarrollo local, los servicios Node corren en tu máquina y SQL Server en Docker.

# Contraseña del usuario "sa" de SQL Server (debe ser compleja: mayúsculas, minúsculas, números y símbolos)
MSSQL_SA_PASSWORD=Cambia_Esta_Passw0rd

# Conexión a SQL Server usada por los servicios
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Cambia_Esta_Passw0rd

# Base de datos compartida y Orders API
DB_NAME=OrderFlowDb
PORT=3000
CORS_ORIGIN=*

# RabbitMQ (los servicios arman la URL de conexión con estos valores)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=Cambia_Esta_Clave
