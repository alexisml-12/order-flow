# Copia este archivo como ".env" (que NO se sube a git) y ajusta los valores.
#
# - Con "docker compose up" el archivo es opcional: si no existe, se usan valores por defecto de demo.
#   Si existe, tus valores reemplazan a los de demo. Los hosts (sqlserver, rabbitmq) los fija el compose.
# - Para desarrollo local (servicios Node en tu máquina y SQL Server/RabbitMQ en Docker),
#   necesitas este archivo: allí los hosts son "localhost".

# Contraseña del usuario "sa" de SQL Server (debe ser compleja: mayúsculas, minúsculas, números y símbolos)
MSSQL_SA_PASSWORD=Cambia_Esta_Passw0rd

# Conexión a SQL Server usada por los servicios
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Cambia_Esta_Passw0rd

# Base de datos compartida y Orders API
DB_NAME=OrderFlowDb
PORT=3000
CORS_ORIGIN=*

# RabbitMQ (los servicios arman la URL de conexión con estos valores)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=Cambia_Esta_Clave

# Puerto donde se publica el frontend con docker compose (opcional)
FRONTEND_PORT=8080
